NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
YANDEX_AUTH_ENABLED=0
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
ADMIN_EMAIL=
# Optional Cloudflare Access admin identity. Server verifies signature/issuer/audience.
# Required when using this admin login method on your server; never use unsigned headers.
AUTH_ACCESS_ISSUER=
AUTH_ACCESS_AUD=
# Server-only optional discovery integrations. No fake responses without keys.
OPENAI_API_KEY=
OPENAI_MODEL=
# RouterAI: server-only key, never use NEXT_PUBLIC_ for secrets.
ROUTERAI_API_KEY=
ROUTERAI_MODEL=qwen/qwen3-30b-a3b-instruct-2507
BRAVE_SEARCH_API_KEY=
# Optional RouterAI web mode: sonar | plugin (exa) | plugin-native | off.
# Model access and billing must be verified before enabling production traffic.
ROUTERAI_WEB_MODE=sonar
ROUTERAI_WEB_MODEL=qwen/qwen3-30b-a3b-instruct-2507
# Configurable monthly RUB budget, not a fixed 3000 RUB ceiling. 0 disables paid calls.
# Invalid/negative values fail closed. Also configure a provider-side spending limit.
API_MONTHLY_LIMIT_RUB=3000
API_MAX_CALL_RUB=20
# Total unresolved reservations plus the next call must fit this safety allowance.
# Unknown entries are not cleared; all reservations stay charged to the monthly budget.
API_UNCERTAIN_LIMIT_RUB=60
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Local routing demos (no key). For production use your own / contracted providers.
PHOTON_URL=https://photon.komoot.io
VALHALLA_URL=https://valhalla1.openstreetmap.de
# Legacy local dev mock only; ignored by production builds.
# Production admin uses verified Access JWT, not unsigned identity headers.
# AUTH_TRUSTED_PROXY=0
# Buyer login and test billing. Keep real tokens only in private server configuration.
BUYER_AUTH_ENABLED=0
BUYER_QUOTA_ENABLED=0
AUTH_BASE_URL=https://naydigo.prepromo.ru
# Passwordless email login through Resend. Verify the sender domain first.
EMAIL_AUTH_ENABLED=0
EMAIL_FROM=НайдиGo <login@naydigo.prepromo.ru>
EMAIL_REPLY_TO=
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
MAX_BOT_TOKEN=
MAX_BOT_URL=
TELEGRAM_WEBHOOK_SECRET=
MAX_WEBHOOK_SECRET=
# Personal recipients for new shop applications. These are your user/chat IDs,
# not the bot IDs. Configure either provider or both.
OWNER_TELEGRAM_CHAT_ID=
OWNER_MAX_USER_ID=
MAX_AUTH_ENABLED=0
MAX_API_BASE_URL=https://platform-api2.max.ru
YOOKASSA_ENABLED=0
YOOKASSA_TEST_MODE=1
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
